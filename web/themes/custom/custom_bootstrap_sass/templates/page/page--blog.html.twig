{#
  BLOG PAGE — CLEAN BASELINE
  Purpose: show blog content exactly as Drupal outputs it
#}

{{ attach_library('custom_bootstrap_sass/global-styling') }}

{{ page_top }}

{# =========================
   RIGHT ICON NAV (WITH TOOLTIPS)
   ========================= #}
<nav class="icon-nav" aria-label="Section navigation">
  <ul>
    <li>
<a href="/" class="{{ path('<current>') == '/' ? 'is-active' }}">
        <i class="fa-solid fa-house"></i>
        <span class="icon-tooltip">Home</span>
      </a>
    </li>
    <li>
<a href="/about-me" class="{{ path('<current>') == '/about-me' ? 'is-active' }}">
        <i class="fa-solid fa-user"></i>
        <span class="icon-tooltip">About</span>
      </a>
    </li>
    <li>
<a href="/portfolio" class="{{ path('<current>') == '/portfolio' ? 'is-active' }}">
        <i class="fa-solid fa-briefcase"></i>
        <span class="icon-tooltip">Portfolio</span>
      </a>
    </li>
      <a href="/blog" class="{{ path('<current>') == '/blog' ? 'is-active' }}">

        <i class="fa-solid fa-pen"></i>
        <span class="icon-tooltip">Blog</span>
      </a>
    </li>
    <li>
  <a href="/contact" class="{{ path('<current>') == '/contact' ? 'is-active' }}">
        <i class="fa-solid fa-envelope"></i>
        <span class="icon-tooltip">Contact</span>
      </a>
    </li>
  </ul>
</nav>

<section class="subpage-hero subpage-hero--blog">

  {# Background word #}
  <div class="subpage-hero__bg-text" aria-hidden="true">
    BLOGS
  </div>

  {# Foreground title #}
  <h1 class="subpage-hero__title">
    MY <span>BLOGS</span>
  </h1>
</div>
</section>


<main id="main-content" class="blog-page" role="main">
  <div class="blog-page__inner">
    {{ page.content }}
  </div>
</main>

{{ page_bottom }}
